<UserControl x:Class="H2LinuxMultiTerminal.TerminalPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 MinHeight="330" Margin="4">
 <Border BorderBrush="#AAB2BD" BorderThickness="1" CornerRadius="5">
  <DockPanel>
   <Border DockPanel.Dock="Top" Background="#E8ECF1" Padding="6">
    <WrapPanel>
     <CheckBox x:Name="SelectedBox" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBlock x:Name="TitleText" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Button Content="定位终端" Click="ArmTarget_Click" Margin="12,0,4,0" Padding="7,2" ToolTip="点击后，再点击网页终端中的输入区域"/>
     <Button Content="刷新" Click="Reload_Click" Margin="4,0" Padding="7,2"/>
     <TextBlock x:Name="TargetText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#555"/>
    </WrapPanel>
   </Border>
   <wv2:WebView2 x:Name="Browser"/>
  </DockPanel>
 </Border>
</UserControl>
